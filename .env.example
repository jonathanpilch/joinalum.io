# Copy to .env (never committed) and fill in.

# fantastic.jobs, for target employers we can't pull directly (ingest/fantastic.mjs)
FANTASTIC_KEY=

# Supabase: the page needs the URL and the PUBLISHABLE (anon) key. Both are
# public by design; row-level security protects the data.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=

# Only for ingest/notify.mjs (radar + reminder emails). Never put these in
# config.js or anything the browser loads.
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
ALUM_FROM=Alum <alerts@joinalum.io>
SITE_URL=https://joinalum.io
