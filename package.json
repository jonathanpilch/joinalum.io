{
  "name": "joinalum",
  "private": true,
  "type": "module",
  "description": "Alum: internships at the companies that hire Hokies, pulled from companies' own career boards.",
  "scripts": {
    "ingest": "node ingest/run.mjs",
    "placements": "node ingest/placements.mjs",
    "targets": "node ingest/targets.mjs",
    "fantastic": "node --env-file=.env ingest/fantastic.mjs",
    "fantastic:probe": "node --env-file=.env ingest/fantastic.mjs --probe",
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "notify": "node --env-file-if-exists=.env ingest/notify.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
